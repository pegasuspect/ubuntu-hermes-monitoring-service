# hermes-sentinel local environment — DO NOT COMMIT
# Loaded automatically by hermes-sentinel at startup.
# Real environment variables take precedence over this file.

# Linked Signal number (the signal-cli account)
SIGNAL_ACCOUNT=+15555550100

# Where alerts are delivered: phone number, or "group:<base64 group id>"
SIGNAL_RECIPIENT=+15555550100

# Trusted senders, comma-separated
SIGNAL_ALLOWED_USERS=+15555550100

# signal-cli JSON-RPC daemon (default shown)
#SIGNAL_HTTP_URL=http://127.0.0.1:8099

# Severities that trigger alerts (default shown)
#NOTIFY_ON=warning,critical